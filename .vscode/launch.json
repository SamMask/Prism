{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Tests (Pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "FLASK_ENV": "testing"
      }
    },
    {
      "name": "Debug E2E (Playwright)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["e2e/", "--headed", "--slowmo=500"],
      "console": "integratedTerminal",
      "env": {
        "PRISM_V2": "true"
      }
    }
  ]
}
